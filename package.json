{
  "name": "recall-app",
  "version": "0.1.0",
  "description": "",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings --watch",
    "format": "prettier --write src",
    "tauri": "tauri",
    "stats": "node scripts/stats.mjs",
    "tests": "npm run test",
    "test": "npm run test:rust && npm run test:frontend",
    "test:rust": "cargo test --lib --manifest-path src-tauri/Cargo.toml",
    "test:frontend": "svelte-kit sync && vitest run",
    "lint": "npm run check && cargo clippy --manifest-path src-tauri/Cargo.toml -- -D warnings"
  },
  "license": "MIT",
  "dependencies": {
    "@fontsource/archivo-black": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@internationalized/date": "^3.12.4",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-opener": "^2",
    "bits-ui": "^2.20.0"
  },
  "devDependencies": {
    "@lucide/svelte": "^1.60.0",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.6.5",
    "clsx": "^2.1.1",
    "mode-watcher": "^1.1.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "sass": "^1.106.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "svelte-sonner": "^1.2.1",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
